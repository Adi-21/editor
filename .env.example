# ─────────────────────────────────────────────────────────────────────
# Beeaver environment variables
#
# For LOCAL DEV: copy this file to `.env.local` in the repo root and
#                fill in the values you need. The dev script reads it.
#
# For VERCEL:    set each variable in the Vercel project's Environment
#                Variables panel (Settings → Environment Variables).
#                Do NOT commit `.env.local` (it's gitignored).
# ─────────────────────────────────────────────────────────────────────


# === PUBLIC URL of the deployed app (used by /present share links etc.) ===
# Vercel sets `NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL` automatically; this
# override takes precedence when you have a custom domain wired.
NEXT_PUBLIC_APP_URL=https://beeaver.in


# === Scene API authentication (server-side) ===
# Required for the /api/scenes routes to accept requests in production.
# Generate a long random secret and set the same value here AND in clients.
# Clients send it as `x-beeaver-scene-token` header or `Authorization: Bearer ...`.
BEEAVER_SCENE_API_TOKEN=

# === Optional: rate-limit + CORS origins for /api/scenes ===
# Requests/min/IP. Defaults sensibly if unset.
BEEAVER_SCENE_API_RATE_LIMIT=60
# Comma-separated list of allowed origins (CSV). Leave unset to allow same-origin only.
BEEAVER_SCENE_API_ORIGINS=https://beeaver.in,https://www.beeaver.in


# === Supabase backend (used by the scene-storage adapter) ===
# Create your own Supabase project at supabase.com → Project Settings → API.
# Without these, scene save/load and live-sync won't work; the in-memory
# fallback only works for the dev playground.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# === Optional: asset CDN ===
# Where 3D models / thumbnails are hosted. If unset, falls back to whatever
# absolute URLs are baked into the catalog. Migrating off Pascal's bucket
# (byrpxoiotywskoojsrzd.supabase.co) is a separate task.
NEXT_PUBLIC_ASSETS_CDN_URL=


# === Optional: legacy ===
# Google Maps API key (enables address search)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Dev server port (default 3002 — set in apps/editor/package.json)
# PORT=3002
